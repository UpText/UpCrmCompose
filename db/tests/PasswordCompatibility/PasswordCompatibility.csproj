<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../../init-image/PasswordHasher/NuGet.config</RestoreConfigFile>
    <ApiHasherSource Condition="'$(ApiHasherSource)' == ''">$(MSBuildThisFileDirectory)../../../../UpTextApi/src/UpTextApi/Services/UpHasher.cs</ApiHasherSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ApiHasherSource)" Link="ApiUpHasher.cs" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
