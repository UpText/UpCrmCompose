SQL_SERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
UPAPI_IMAGE=docker.io/uptext/upapi:latest
UPCRM_IMAGE=docker.io/uptext/upcrm:latest
RUNTIME_PLATFORM=linux/amd64

MSSQL_SA_PASSWORD=ChangeThis_SA_Password_123!
MSSQL_DB=UpCrm
MSSQL_PID=Developer
UPAPI_SQL_USER=upservice
UPAPI_SQL_PASSWORD=ChangeThis_UpService_Password_123!

UPAPI_SQL_SCHEMA=crmapi
JWT_SECRET=ChangeThis_To_A_Long_Random_Secret_At_Least_32_Chars
JWT_ISSUER=UpApi
JWT_AUDIENCE=UpCrm
JWT_HOURS=8

SQL_PORT=1433
UPAPI_PORT=5092
UPCRM_PORT=8082

UPAPI_PUBLIC_URL=http://localhost:5092
UPCRM_PUBLIC_URL=http://localhost:8082
UPCRM_SERVICE=crmapi

# Optional external SQL Server settings for compose.external-sql.yaml.
# Example on Docker Desktop: EXTERNAL_SQL_SERVER=host.docker.internal
# Example on another SQL host: EXTERNAL_SQL_SERVER=192.168.1.50
EXTERNAL_SQL_SERVER=
EXTERNAL_SQL_PORT=1433
EXTERNAL_SQL_ADMIN_USER=sa
EXTERNAL_SQL_ADMIN_PASSWORD=

DEPLOY_VERSION=local-compose
GIT_COMMIT=manual
DEPLOYED_BY=docker-compose
DEPLOYMENT_TARGET=docker-compose
