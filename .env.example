# Copy this file to `.env` before starting the stack.
# Replace the placeholder secrets below before using this outside local development.

# Container images and runtime platform.
SQL_SERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
UPAPI_IMAGE=docker.io/uptext/upapi:latest
UPCRM_IMAGE=docker.io/uptext/upcrm:latest
RUNTIME_PLATFORM=linux/amd64

# Local SQL Server and app database credentials.
MSSQL_SA_PASSWORD=ChangeThis_SA_Password_123!
MSSQL_DB=UpCrm
MSSQL_PID=Developer
ADMIN_TENANT_PASSWORD=ChangeThis_Admin_Tenant_Password_123!
UPAPI_SQL_USER=upservice
UPAPI_SQL_PASSWORD=ChangeThis_UpService_Password_123!
UPAPI_SQLLOG_SCHEMA=dbo
UPAPI_SQLLOG_TABLE=log
UPAPI_SQLLOG_RETENTION_DAYS=30

# App auth settings shared between UpApi and UpCrm.
# Use a long random JWT secret so issued tokens remain valid across restarts.
UPAPI_SQL_SCHEMA=crmapi
UPAPI_TABLE_SCHEMA=crm
JWT_SECRET=ChangeThis_To_A_Long_Random_Secret_At_Least_32_Chars
JWT_ISSUER=UpApi
JWT_AUDIENCE=UpCrm
JWT_HOURS=8

# Host ports exposed by docker compose.
SQL_PORT=1433
UPAPI_PORT=8880
UPCRM_PORT=8080

# Public URLs the services use to talk to each other and for browser access.
UPAPI_PUBLIC_URL=http://localhost:8880
UPCRM_PUBLIC_URL=http://localhost:8080
UPCRM_SERVICE=crmapi

# Browser origins allowed to call UpApi.
# For workstation installs, keep origin 0 as http://localhost:8080.
# For hosted installs, set origin 0 to the public UpCRM URL.
UPAPI_CORS_ALLOWED_ORIGIN_0=http://localhost:8080
UPAPI_CORS_ALLOWED_ORIGIN_1=http://localhost:5173
UPAPI_CORS_ALLOWED_ORIGIN_2=http://localhost:5174

# Optional external SQL Server settings for compose.external-sql.yaml.
# Leave these blank if you are using the bundled SQL Server from compose.yaml.
# Example on Docker Desktop: EXTERNAL_SQL_SERVER=host.docker.internal
# Example on another SQL host: EXTERNAL_SQL_SERVER=192.168.1.50
EXTERNAL_SQL_SERVER=
EXTERNAL_SQL_PORT=1433
EXTERNAL_SQL_ADMIN_USER=sa
EXTERNAL_SQL_ADMIN_PASSWORD=

# Deployment metadata used for diagnostics/version display.
DEPLOY_VERSION=local-compose
GIT_COMMIT=manual
DEPLOYED_BY=docker-compose
DEPLOYMENT_TARGET=docker-compose
